{
  "manifest_version": 3,
  "name": "AttendIQ",
  "version": "1.0.0",
  "description": "Automatically monitors EduPlusCampus attendance and notifies when attendance is marked.",
  "permissions": [
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://learner.vierp.in/*",
    "https://learnerapi.vierp.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learner.vierp.in/attendance*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AttendIQ"
  }
}